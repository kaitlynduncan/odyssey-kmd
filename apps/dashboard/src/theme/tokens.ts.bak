// Centralized design tokens. Every primitive component and the UI library
// route both read from this file directly — there is no second copy of
// these values anywhere in the app.
//
// Palette adapted from Ody (pro.ody.app): white/light-lavender surfaces,
// a saturated violet as the primary accent, pink and yellow as secondary
// brand accents (from the Ody logomark), fully pill-shaped interactive
// elements, and bold geometric headline type.

export const color = {
  // Base surfaces
  bg: "#F7F7FB",
  surface: "#FFFFFF",
  surfaceSunken: "#F1EFFA",
  border: "#E7E4F3",
  borderStrong: "#D3CDEC",

  // Text
  textPrimary: "#161221",
  textSecondary: "#6B6580",
  textMuted: "#9993AC",
  textInverse: "#FFFFFF",

  // Brand / accent — vivid violet, matching Ody's primary brand color.
  accent: "#6C5CE7",
  accentHover: "#5646C9",
  accentSubtle: "#EFEBFC",

  // Secondary brand accents, from the Ody logomark — used sparingly for
  // illustrative touches (icons, highlights), not as functional/semantic
  // colors.
  brandPink: "#EC4899",
  brandPinkSubtle: "#FCE7F3",
  brandYellow: "#FBBF24",
  brandYellowSubtle: "#FEF3C7",
  brandCyan: "#22D3EE",
  brandCyanSubtle: "#E0F9FD",

  // Semantic states
  success: "#1F9D6B",
  successSubtle: "#E3F7EE",
  warning: "#B4790E",
  warningSubtle: "#FCF0DA",
  danger: "#DC3545",
  dangerSubtle: "#FCEAEC",
  info: "#6C5CE7",
  infoSubtle: "#EFEBFC",
} as const;

export const spacing = {
  xs: 4,
  sm: 8,
  md: 12,
  lg: 16,
  xl: 24,
  xxl: 32,
  xxxl: 48,
} as const;

export const radius = {
  sm: 6,
  md: 10,
  lg: 16,
  xl: 20,
  pill: 999,
} as const;

export const elevation = {
  none: { shadowOpacity: 0},
  low: {
    shadowColor: "#221B4D",
    shadowOffset: { width: 0, height: 1 },
    shadowOpacity: 0.05,
    shadowRadius: 3,
  },
  medium: {
    shadowColor: "#221B4D",
    shadowOffset: { width: 0, height: 6 },
    shadowOpacity: 0.08,
    shadowRadius: 16,
  },
  high: {
    shadowColor: "#221B4D",
    shadowOffset: { width: 0, height: 16 },
    shadowOpacity: 0.14,
    shadowRadius: 32,
  },
} as const;

export const typography = {
  fontFamily: "System",
  display: { fontSize: 30, fontWeight: "700" as const, lineHeight: 36 },
  h1: { fontSize: 23, fontWeight: "700" as const, lineHeight: 29 },
  h2: { fontSize: 18, fontWeight: "700" as const, lineHeight: 24 },
  h3: { fontSize: 15, fontWeight: "600" as const, lineHeight: 20 },
  body: { fontSize: 14, fontWeight: "400" as const, lineHeight: 21 },
  bodyStrong: { fontSize: 14, fontWeight: "600" as const, lineHeight: 21 },
  caption: { fontSize: 12, fontWeight: "400" as const, lineHeight: 16 },
  label: { fontSize: 11, fontWeight: "700" as const, lineHeight: 14 },
} as const;

// Named semantic-state colors, used by Badge/Toast/inline validation so
// "success" always means the same green everywhere. "info"/"neutral" lean
// on the brand accent and a light lavender so they read as part of the same
// family as everything else, rather than a generic default blue/gray.
export const semanticState = {
  success: { fg: color.success, bg: color.successSubtle },
  warning: { fg: color.warning, bg: color.warningSubtle },
  danger: { fg: color.danger, bg: color.dangerSubtle },
  info: { fg: color.info, bg: color.infoSubtle },
  neutral: { fg: color.textSecondary, bg: color.surfaceSunken },
} as const;

export type SemanticState = keyof typeof semanticState;
